# Copy this file to .env and keep the real file private.

# Public URL created by Tailscale Serve. Do not include a real tailnet hostname
# in commits or support requests.
WEBUI_URL=https://replace-with-your-private-tailnet-name

# Promoted OpenAI-compatible endpoint reachable only through the tailnet.
INFERENCE_API_BASE_URL=https://MODEL_HOST.TAILNET_NAME.ts.net:8443/v1
# Hostname only. This keeps inference outside the VPN used for web search.
INFERENCE_NO_PROXY_HOST=MODEL_HOST.TAILNET_NAME.ts.net
INFERENCE_API_KEY=replace-with-a-random-local-api-key

# Generate independent values, for example with: openssl rand -hex 32
WEBUI_SECRET_KEY=replace-with-a-random-webui-secret
SEARXNG_SECRET=replace-with-a-random-search-secret

# Open WebUI account bootstrap. Leave enabled only while creating intended
# household accounts, then disable it in the Admin UI.
ENABLE_SIGNUP=true
DEFAULT_MODELS=household-primary

# VPN configuration. Version 0.1 verifies Surfshark WireGuard; other Gluetun
# providers are possible but are not part of the tested support promise.
VPN_SERVICE_PROVIDER=surfshark
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=replace-with-your-vpn-wireguard-private-key
WIREGUARD_ADDRESSES=replace-with-your-vpn-wireguard-address
VPN_SERVER_COUNTRIES=replace-with-your-preferred-country

# Use an IANA time-zone identifier appropriate for the deployment.
TZ=Etc/UTC
