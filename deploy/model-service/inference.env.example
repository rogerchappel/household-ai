# Copy to ~/.config/household-ai/inference.env on the selected Ubuntu model host.
# This file contains no API key. Keep the real model path private when needed.

LLAMA_SERVER_BIN=/opt/llama.cpp/bin/llama-server
MODEL_PATH=/srv/household-ai/models/selected-model.gguf

# Stable client-facing name. Do not encode a filename or quantization here.
MODEL_ALIAS=household-primary

# These values must come from the accepted benchmark configuration.
MODEL_PORT=18080
MODEL_CONTEXT=32768
MODEL_PARALLEL=2
MODEL_GPU_LAYERS=99

# F16 is the conservative default. Q8_0 reduces KV-cache memory and may improve
# long-context performance on memory-bandwidth-limited hardware. Benchmark it
# with the selected model and accelerator before promotion.
MODEL_CACHE_TYPE_K=f16
MODEL_CACHE_TYPE_V=f16
